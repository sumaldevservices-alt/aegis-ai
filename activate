#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Aegis dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `aegis` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-aegis-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `aegis pm
# install` and `aegis update` keep that check.
# ============================================================================
_AEGIS_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_aegis_test_env="--test-environment"
_aegis_expect_extras=""
for _aegis_arg in "$@"; do
    if [ -n "$_aegis_expect_extras" ]; then
        _aegis_test_env="--test-environment=$_aegis_arg"
        _aegis_expect_extras=""
        continue
    fi
    case "$_aegis_arg" in
        --) break ;;
        --test-extras) _aegis_expect_extras=1 ;;
        --test-extras=*) _aegis_test_env="--test-environment=${_aegis_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_aegis_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _aegis_arg _aegis_test_env _aegis_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _aegis_arg _aegis_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_AEGIS_REPO/scripts/_activation.sh"

if ! aegis_sync "$_AEGIS_REPO" "$_aegis_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _aegis_test_env
    return 1 2>/dev/null || exit 1
fi
unset _aegis_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __AEGIS_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_aegis_script="$(aegis_compose_env "$_AEGIS_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _aegis_script
    return 1 2>/dev/null || exit 1
}
_aegis_keys="$(printf '%s\n' "$_aegis_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __AEGIS_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__AEGIS_SAVED_PATH="$PATH"
for _aegis_k in $_aegis_keys; do
    eval "__AEGIS_SAVED_$_aegis_k=\"\${$_aegis_k+set}\""
    eval "__AEGIS_PRIOR_$_aegis_k=\${$_aegis_k-__AEGIS_UNSET__}"
done
aegis_apply_env "$_aegis_script"

# This checkout, not whichever `aegis` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__AEGIS_WORKTREE="$_AEGIS_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__AEGIS_WORKTREE_NAME="$(git -C "$_AEGIS_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__AEGIS_WORKTREE_NAME" ] || [ "$__AEGIS_WORKTREE_NAME" = HEAD ]; then
    __AEGIS_WORKTREE_NAME="$(basename "$_AEGIS_REPO")"
fi
__AEGIS_SAVED_PS1="${PS1-__AEGIS_UNSET__}"
__AEGIS_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__AEGIS_UNSET__}"

_aegis_worktree_here() {
    _aegis_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_aegis_top" && pwd -P)" = "$(cd "$__AEGIS_WORKTREE" && pwd -P)" ]
}

aegis() {
    _aegis_worktree_here || {
        printf '%s\n' "aegis: $(pwd) is outside $__AEGIS_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__AEGIS_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" aegis "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe aegis "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python aegis "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe aegis "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python aegis "$@"
        else
            exec python aegis "$@"
        fi
    )
}

_aegis_prompt() {
    if [ "$__AEGIS_SAVED_PS1" = "__AEGIS_UNSET__" ]; then
        _aegis_base_ps1=""
    else
        _aegis_base_ps1="$__AEGIS_SAVED_PS1"
    fi
    if _aegis_worktree_here; then
        PS1="($__AEGIS_WORKTREE_NAME) $_aegis_base_ps1"
    else
        PS1="$_aegis_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_aegis_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_aegis_prompt
fi
_aegis_prompt

deactivate() {
    export PATH="$__AEGIS_SAVED_PATH"
    for _aegis_k in $__AEGIS_KEY_LIST; do
        eval "_aegis_was=\"\$__AEGIS_SAVED_$_aegis_k\""
        eval "_aegis_old=\"\$__AEGIS_PRIOR_$_aegis_k\""
        if [ "$_aegis_was" != "set" ]; then
            unset "$_aegis_k"
        else
            export "$_aegis_k=$_aegis_old"
        fi
        unset "__AEGIS_SAVED_$_aegis_k" "__AEGIS_PRIOR_$_aegis_k"
    done
    if [ "$__AEGIS_SAVED_PS1" = "__AEGIS_UNSET__" ]; then
        unset PS1
    else
        PS1="$__AEGIS_SAVED_PS1"
    fi
    if [ "$__AEGIS_SAVED_PROMPT_COMMAND" = "__AEGIS_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__AEGIS_SAVED_PROMPT_COMMAND"
    fi
    unset __AEGIS_SAVED_PATH __AEGIS_KEY_LIST __AEGIS_ACTIVATED \
          __AEGIS_WORKTREE __AEGIS_WORKTREE_NAME \
          __AEGIS_SAVED_PS1 __AEGIS_SAVED_PROMPT_COMMAND
    unset -f deactivate aegis _aegis_worktree_here _aegis_prompt
    unset _aegis_k _aegis_was _aegis_old _aegis_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__AEGIS_KEY_LIST="$_aegis_keys"

# The composition library is not part of the user's shell.
unset -f aegis_sync aegis_bootstrap_python aegis_compose_env aegis_apply_env \
         aegis_activation_current aegis_ensure_env
unset _AEGIS_REPO _aegis_script _aegis_keys _aegis_k _aegis_top
